# File: .env.example
# Purpose: Template for all environment variables required by the application.
# Connects: Copy this to '.env' and fill in the values. The .env file is git-ignored.
#           core/config.py loads and validates these variables at startup.

# The name of the deployment environment (e.g., development, staging, production).
# Used to label log lines so you can filter by environment in aggregation tools.
ENVIRONMENT=development

# The minimum log verbosity level (DEBUG / INFO / WARNING / ERROR).
# DEBUG produces very high log volume — use INFO or above in production.
LOG_LEVEL=INFO

# Number of gunicorn worker processes to spawn.
# Each worker is an independent OS process running a uvicorn ASGI event loop.
# Guideline: (2 * cpu_count) + 1 formula is the standard starting point.
# On the dev machine (8-core laptop), that is 17.
# However, memory and GPU sharing constraints mean 2–4 is more appropriate here.
# This env var is read directly by infra/docker/gunicorn_conf.py.
WORKER_COUNT=2

# The maximum number of pending connections.
# This governs the queue size for incoming requests when all workers are busy.
BACKLOG=2048

# Workers silent for more than this many seconds are killed and restarted.
TIMEOUT=30

# The number of seconds to wait for requests on a Keep-Alive connection.
KEEPALIVE=2

# The maximum number of requests a worker will process before restarting.
# A value of 0 disables automatic restarts. Set this to a non-zero value
# (e.g., 10000) to help limit memory leaks.
MAX_REQUESTS=0

# The maximum jitter to add to the max_requests setting.
# Prevents all workers from restarting at the exact same time.
MAX_REQUESTS_JITTER=0

# PostgreSQL connection string (REQUIRED).
# Controls the connection endpoint, credentials, and database target for relational storage.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example for local development outside Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ashfall
# Example for containerized Docker Compose network:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ashfall

# Minimum number of connections in the asyncpg database pool.
DB_POOL_MIN_SIZE=2

# Maximum number of connections in the asyncpg database pool.
DB_POOL_MAX_SIZE=10

# Redis connection string (REQUIRED).
# Controls the connection endpoint and database index for the Redis cache/event store.
# Format: redis://<host>:<port>/<db_index>
# Example for local development outside Docker:
# REDIS_URL=redis://localhost:6379/0
# Example for containerized Docker Compose network:
REDIS_URL=redis://redis:6379/0

# Postgres container credentials
# These must match the DATABASE_URL connection string above
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ashfall

# Maximum number of requests Triton will process in a single batch.
# Increase this for higher GPU utilisation on large workloads.
# Decrease it to reduce per-request latency under light load.
TRITON_MAX_BATCH=128

# Number of threads available for background or blocking work (e.g. file I/O,
# synchronous database calls). Increase if you see blocked async tasks in logs.
WORKER_THREADS=4

# The URL where the API sends OpenTelemetry traces.
# Tempo listens on this endpoint and stores the traces for Grafana to display.
# Change the host if Tempo is running on a different machine or port.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# Grafana admin password. Change this before running in a shared environment.
GRAFANA_PASSWORD=admin

# Batch size at/above which geo-velocity uses the GPU kernel (measured in Level 4.5 benchmark)
GEO_KERNEL_CROSSOVER_BATCH_SIZE=100

# MLflow local SQLite database used by the Level 5 training scripts (view with: mlflow ui --backend-store-uri sqlite:///mlflow.db)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# CI model-quality gate (scripts/ci_quality_gate.py): the build fails if the committed PR-AUC is below this floor.
# PR-AUC, not ROC-AUC, because it is the honest metric for rare fraud. The current model scores about 0.9947.
MODEL_AUC_THRESHOLD=0.92

# Kafka (Redpanda) address used by scripts and services. Default is the address that works from your own machine
# (compose publishes the broker on localhost:19092). From INSIDE another compose container use redpanda:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Outbox relay (api/services/outbox_relay.py): the Kafka topic it publishes to, how long it waits between checks
# when idle, how many events it sends per round, and the longest pause between retries when Kafka is down.
KAFKA_OUTBOX_TOPIC=transactions.created
# KAFKA_UPI_TOPIC=upi.payments
RELAY_POLL_INTERVAL_SECONDS=1.0
RELAY_BATCH_SIZE=100
RELAY_MAX_BACKOFF_SECONDS=30.0
# How many times the relay tries a message that Kafka rejects for its own sake (for example a message that is
# too large) before it parks that message in the outbox_dead_letter table and carries on with the next ones.
# 5 is enough to rule out a one-off glitch, yet short (about 5 poll cycles of 1 second) so one bad message
# cannot hold up the queue for long. Connection problems and timeouts NEVER count towards this limit: when
# Kafka is down the relay just waits and retries. Lower = parks faster, higher = more patience.
RELAY_MAX_ATTEMPTS=5
# The port on which the relay serves its metrics (such as outbox_dead_lettered_total) for Prometheus. It is only
# reachable inside the compose network.
RELAY_METRICS_PORT=9108

# Feature switches for later levels. A later level will read each one; today nothing does, and False (the default)
# means the system behaves exactly as it does now. Use true or false.
# Switch for the bank integration API (a later level).
ENABLE_BANK_INTEGRATION_API=false
# Switch for model v2 (a later level).
ENABLE_MODEL_V2=false
# Switch for the graph neural network (GNN) ensemble (a later level).
ENABLE_GNN_ENSEMBLE=false
# Switch that lets the research agent use the internet (a later level). Keep false: the system must not go online.
ENABLE_RESEARCH_AGENT_INTERNET=false
