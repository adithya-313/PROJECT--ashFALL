# File: .env.example
# Purpose: Template for all environment variables required by the application.
# Connects: Copy this to '.env' and fill in the values. The .env file is git-ignored.
#           core/config.py loads and validates these variables at startup.

# The name of the deployment environment (e.g., development, staging, production).
# Used to label log lines so you can filter by environment in aggregation tools.
ENVIRONMENT=development

# The minimum log verbosity level (DEBUG / INFO / WARNING / ERROR).
# DEBUG produces very high log volume — use INFO or above in production.
LOG_LEVEL=INFO

# Number of gunicorn worker processes to spawn.
# Each worker is an independent OS process running a uvicorn ASGI event loop.
# Guideline: (2 * cpu_count) + 1 formula is the standard starting point.
# On the dev machine (8-core laptop), that is 17.
# However, memory and GPU sharing constraints mean 2–4 is more appropriate here.
# This env var is read directly by infra/docker/gunicorn_conf.py.
WORKER_COUNT=2

# PostgreSQL connection string (REQUIRED).
# Controls the connection endpoint, credentials, and database target for relational storage.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example for local development outside Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ashfall
# Example for containerized Docker Compose network:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ashfall

# Redis connection string (REQUIRED).
# Controls the connection endpoint and database index for the Redis cache/event store.
# Format: redis://<host>:<port>/<db_index>
# Example for local development outside Docker:
# REDIS_URL=redis://localhost:6379/0
# Example for containerized Docker Compose network:
REDIS_URL=redis://redis:6379/0
