# File: .env.example
# Purpose: Provides a template for the environment variables required by the application.
# Connects: Developers should copy this to '.env' and fill in the values. The config module reads these variables.

# The name of the environment (e.g., development, staging, production)
ENVIRONMENT=development

# The logging level for the application (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
