{
  "component_schemas": {
    "AccountEventResponse": {
      "additionalProperties": false,
      "description": "The result of recording an account event; duplicate is true when the event id was already stored.",
      "properties": {
        "duplicate": {
          "title": "Duplicate",
          "type": "boolean"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "duplicate"
      ],
      "title": "AccountEventResponse",
      "type": "object"
    },
    "ComplaintResponse": {
      "additionalProperties": false,
      "description": "The result of storing a complaint.",
      "properties": {
        "complaint_id": {
          "title": "Complaint Id",
          "type": "string"
        }
      },
      "required": [
        "complaint_id"
      ],
      "title": "ComplaintResponse",
      "type": "object"
    },
    "DecisionResponse": {
      "additionalProperties": false,
      "description": "The answer to a decision request.",
      "properties": {
        "decision": {
          "const": "unscored",
          "title": "Decision",
          "type": "string"
        },
        "mode": {
          "enum": [
            "shadow",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "payment_id": {
          "title": "Payment Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "payment_id",
        "decision",
        "mode",
        "reason"
      ],
      "title": "DecisionResponse",
      "type": "object"
    },
    "FeedbackResponse": {
      "additionalProperties": false,
      "description": "The result of storing feedback.",
      "properties": {
        "feedback_id": {
          "title": "Feedback Id",
          "type": "string"
        }
      },
      "required": [
        "feedback_id"
      ],
      "title": "FeedbackResponse",
      "type": "object"
    },
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "title": "Detail",
          "type": "array"
        }
      },
      "title": "HTTPValidationError",
      "type": "object"
    },
    "HealthResponse": {
      "properties": {
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "environment"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "RiskResponse": {
      "additionalProperties": false,
      "description": "The risk of one account (always \"unscored\" until Level 19).",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "shadow",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "risk": {
          "const": "unscored",
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "risk",
        "mode"
      ],
      "title": "RiskResponse",
      "type": "object"
    },
    "ScoreResponse": {
      "description": "Fraud score result returned to the caller.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "fraud_score": {
          "title": "Fraud Score",
          "type": "number"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "transaction_id": {
          "title": "Transaction Id",
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "account_id",
        "fraud_score",
        "model_version"
      ],
      "title": "ScoreResponse",
      "type": "object"
    },
    "TransactionRequest": {
      "description": "Incoming transaction to be scored for fraud risk.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "device_fingerprint": {
          "title": "Device Fingerprint",
          "type": "string"
        },
        "geo_coordinates": {
          "title": "Geo Coordinates",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idempotency Key"
        },
        "merchant_id": {
          "title": "Merchant Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "account_id",
        "merchant_id",
        "device_fingerprint",
        "geo_coordinates"
      ],
      "title": "TransactionRequest",
      "type": "object"
    },
    "TransactionResponse": {
      "additionalProperties": false,
      "description": "The result of recording one transaction side.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "transaction_id": {
          "title": "Transaction Id",
          "type": "string"
        },
        "was_replay": {
          "title": "Was Replay",
          "type": "boolean"
        }
      },
      "required": [
        "transaction_id",
        "event_id",
        "was_replay"
      ],
      "title": "TransactionResponse",
      "type": "object"
    },
    "ValidationError": {
      "properties": {
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Location",
          "type": "array"
        },
        "msg": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "title": "Error Type",
          "type": "string"
        }
      },
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "title": "ValidationError",
      "type": "object"
    }
  },
  "metrics_endpoint_present": true,
  "routes": {
    "/debug/error": {
      "methods": [
        "get"
      ]
    },
    "/health": {
      "details": {
        "get": {
          "request_body": null,
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HealthResponse"
                  }
                }
              },
              "description": "Successful Response"
            }
          }
        }
      },
      "methods": [
        "get"
      ]
    },
    "/metrics": {
      "methods": [
        "get"
      ]
    },
    "/score": {
      "details": {
        "post": {
          "request_body": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ScoreResponse"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          }
        }
      },
      "methods": [
        "post"
      ]
    },
    "/v1/account-events": {
      "methods": [
        "post"
      ]
    },
    "/v1/accounts/{account_id}/risk": {
      "methods": [
        "get"
      ]
    },
    "/v1/complaints": {
      "methods": [
        "post"
      ]
    },
    "/v1/decisions": {
      "methods": [
        "post"
      ]
    },
    "/v1/feedback": {
      "methods": [
        "post"
      ]
    },
    "/v1/transactions": {
      "methods": [
        "post"
      ]
    }
  }
}
