# Ignore environment files
.env
# Ignore Python artifacts
__pycache__/
*.py[cod]
*$py.class

# Model weight files — these can be hundreds of MB to several GB.
# They must never be committed to git; use DVC or cloud storage instead.
*.pt
*.bin
*.onnx
*.safetensors
*.pkl

# Raw PaySim CSV — too large for git, not DVC-tracked (source data, not a pipeline artifact)
data/raw/paysim.csv

# Parquet data files — columnar data format used for processed feature sets.
# Like model weights, these belong in DVC/S3, not in the git history.
*.parquet

# Model directory contents — ignore everything inside models/ subdirectories.
# The subdirectories themselves are tracked via .gitkeep files (added in Task 8).
# This pattern ignores any actual model artifacts that land inside those folders.
models/**/*.pt
models/**/*.bin
models/**/*.onnx
models/**/*.safetensors
models/**/*.pkl
models/**/*.parquet

# Level 5 ML training artifacts
catboost_info/
mlruns/
data/processed/
data/enriched/*.bak
graphify-out/

# graphify (local code-graph tool — personal tooling, not part of the repo)
.claude/
CLAUDE.md

# MLflow local SQLite tracking database
mlflow.db
models/**/*.ubj

# Generated showcase reports: they change on every run and contain timestamps.
reports/showcase/
