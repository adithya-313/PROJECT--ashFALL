# File: envs/truth.env.example
# Purpose: Template environment configuration for hidden truth simulation artifacts.
#
# WHY THIS FILE IS SEPARATED FROM .env.example:
# Operational banking services (api, serving, models, core, features, online_learning, agent)
# boot using .env.example and must never have knowledge of or access to the hidden truth directory.
# Synthetic simulation ground truth (mule roles, syndicate owners, device takeovers, attack narratives)
# is strictly isolated under Ground Rule 15 and Level 12b architecture.
#
# Evaluation harnesses, benchmark pipelines, and verification scripts load this environment file
# explicitly when inspecting simulation ground truth. Banking production containers and compose
# stacks must never load this file or set this variable.

# Directory where the simulation engine writes hidden truth artifacts (roles.jsonl,
# device_control.jsonl, payment_stories.jsonl, manifest.json) and where evaluation/truth.py loads them.
ASHFALL_TRUTH_DIR=runs/truth
